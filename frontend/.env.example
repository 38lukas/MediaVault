# Public API base URL baked into the static frontend at build time.
#
# IMPORTANT: This must be your FastAPI *Web Service* URL on Render, NOT the
# Static Site URL. Hitting the static site with /api/v1/entries returns a
# Next.js HTML 404 because FastAPI is not running there.
#
# Local default when unset: http://127.0.0.1:8000/api/v1
#
# Example (replace with your backend service hostname):
NEXT_PUBLIC_API_URL=https://<your-fastapi-service>.onrender.com/api/v1
