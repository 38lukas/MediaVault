# ==========================================
# Root & General
# ==========================================
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak

# Environment variables (Wichtig für API-Keys & DB-URLs)
.env
.env*.local
.env.production
.env.development

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo

# ==========================================
# Backend (Python / FastAPI)
# ==========================================
# Virtual Environments
backend/venv/
backend/env/
backend/ENV/
backend/env.bak/
backend/venv.bak/

# Python Cache & Compiled Files
**/__pycache__/
*.py[cod]
*$py.class

# Testing & Coverage
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# Database (falls sqlite/lokale DBs genutzt werden)
backend/*.sqlite3
backend/*.db

# ==========================================
# Frontend (Next.js / Node)
# ==========================================
# Dependencies
frontend/node_modules/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions

# Next.js Build Output
frontend/.next/
frontend/out/
frontend/build/

# Debug Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*

# Vercel & TS Build Info
frontend/.vercel
frontend/*.tsbuildinfo
frontend/next-env.d.ts