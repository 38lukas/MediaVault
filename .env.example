# Copy to `.env` in the repo root and fill in your values.

# PostgreSQL (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Twitch / IGDB (backend cover lookup)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# TMDB (backend cover lookup for movies / series / anime)
# Use the API Read Access Token from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token

# Frontend API base (baked into the Next.js static export at build time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
