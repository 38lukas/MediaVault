# Copy to `.env` in the repo root and fill in your values.

# PostgreSQL (Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Twitch / IGDB (backend cover lookup)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# TMDB (backend cover lookup for movies / series / anime)
# Use the API Read Access Token from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token

# Frontend API base (baked into the Next.js static export at build time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# S3-compatible storage for avatars (AWS S3, Cloudflare R2, etc.)
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
# AWS region, or "auto" for Cloudflare R2
S3_REGION=auto
# Leave empty for AWS; for R2 use https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Public URL prefix for objects (R2 public bucket / custom domain / CloudFront)
# Example R2: https://pub-xxxxx.r2.dev
# Example AWS: https://your-bucket.s3.eu-central-1.amazonaws.com
S3_PUBLIC_BASE_URL=
# Optional. Only set if your bucket allows object ACLs (e.g. public-read)
# S3_OBJECT_ACL=public-read
